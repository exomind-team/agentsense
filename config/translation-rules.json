            "metric_role": "used",
            "metric_identity": "cost",
            "time_behavior": "cumulative",
            "unit_family": "currency"
          }
        }
      },
      "computed": {
        "totalTokens": {
          "sumOf": [
            "inputTokens",
            "outputTokens",
            "cacheReadInputTokens",
            "cacheCreationInputTokens"
          ],
          "target": "model.tokens.total",
          "unit": "token",
          "outputField": "tokens",
          "semantics": {
            "metric_role": "used",
            "metric_identity": "tokens",
            "time_behavior": "cumulative",
            "unit_family": "token"
          }
        }
      }
